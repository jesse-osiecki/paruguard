# Test fixture for PLAN.md §11 test 6 — secrets isolation (I3).
# build() fails if it can see any ssh keys — the build namespace must never
# have $HOME/~/.ssh bind-mounted in.
pkgname=paruguard-test-secrets
pkgver=1.0
pkgrel=1
pkgdesc="paruguard test fixture: build() must not see ~/.ssh"
arch=('any')
url="https://example.invalid"
license=('MIT')

build() {
	if compgen -G "$HOME/.ssh/id_*" > /dev/null 2>&1; then
		echo "paruguard-test: SECRET LEAK — found ssh keys visible inside the build" >&2
		exit 1
	fi
	echo "paruguard-test: no ssh keys visible (expected under I3)" >&2
}

package() {
	mkdir -p "$pkgdir/usr/share/$pkgname"
}
